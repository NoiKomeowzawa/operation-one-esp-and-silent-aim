local function NameTeammate()
    for _,Viewmodel in PlayerModels:GetChildren() do
        if Viewmodel.Name == "LocalViewmodel" then
            LocalPlayerModel = Viewmodel
        end
        if not Viewmodel then return end
    end
    for _, child in workspace:GetChildren() do
        if child:IsA("Highlight") and child.OutlineColor ~= Color3.fromRGB(200,0,0) then
            local adornee = child.Adornee
            if adornee and adornee.Name ~= "Teammate" then
                adornee.Name = "Teammate"
            end
        end
    end
    if Settings.RemoveScope == true then
        for _,ScopePart in PlayerModels:GetDescendants() do
            if ScopePart.Name == "ScopeModel" then
                if ScopePart:FindFirstChildOfClass("Folder") then continue end
                
                for _,Part in ScopePart:GetChildren() do
                    local ScopeTint = Part:FindFirstChildOfClass("Decal")
                    if Part.Name == "RedDot" then continue end
                    if ScopeTint then
                        ScopeTint.Texture = 1
                    end
                    Part.Transparency = 0.75
                end
            end
        end
    end
    
    if Settings.RemoveArms == true then
        local TransparentArms = {"arm1", "arm2", "shoulder1", "shoulder2"}
        if not LocalPlayerModel then return end
        for i,Arm in LocalPlayerModel:GetDescendants() do
            if not Arm then return end
            if table.find(TransparentArms, Arm.Name) then
                if Arm:IsA("Model") then
                    
                    for _,part in Arm:GetChildren() do
                        part.Transparency = 0.75
                    end
                elseif Arm:IsA("Part") then
                    Arm.Transparency = 0.9
                end
            end
        end
    end
end
