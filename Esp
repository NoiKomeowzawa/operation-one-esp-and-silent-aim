local function GunModifications()
    
    for _,Gun in LocalPlayerModel:GetChildren() do
        if Gun:IsA("Model") and Gun.Name ~= "Model" then
            if not Gun then return end
            Gun.Gun.firerate.Value = GunSettings.firerate
            Gun.Gun.recoil_up.Value = GunSettings.recoil_up
            Gun.Gun.recoil_side.Value = GunSettings.recoil_side
            Gun.Gun.speed.Value = GunSettings.Walkspeed
            Gun.Gun.spread.Value = GunSettings.spread
            Gun.Gun.ads.Value = GunSettings.ads
            if GunSettings.AlterReloadSpeed == true then Gun.Gun.reload_speed.Value = GunSettings.reload_speed end
            if GunSettings.AlterReloadSpeedWithDivide == true then Gun.Gun.reload_speed.Value = (Gun.Gun.reload_speed.Value / 3) + 0.3 end
            
        end
    end
end
local function SoftWallTransparency()
    for _,part in workspace:GetDescendants() do
        if part:IsA("Configuration") and part.Name == "Breakable" or part.Name == "SoftWall"  then
