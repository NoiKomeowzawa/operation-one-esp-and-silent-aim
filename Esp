local function Crosshair()
	
	local RunService = game:GetService("RunService")
	
	local THICKNESS, ROT_SPEED, PULSE_SPEED = 3, 0.5, 5
	local MIN_LEN, MAX_LEN = -10, -30
	local t, progress = 0, 0

	local function addStroke(parent, mode)
		local s = Instance.new("UIStroke")
		s.ApplyStrokeMode = mode
		s.Color = Color3.new(255, 255, 255)
		s.Thickness = 2
		s.Parent = parent
	end

	local gui = Instance.new("ScreenGui")
	gui.Name = "AimSightGUI"
	gui.ResetOnSpawn = false
	gui.Parent = lp:WaitForChild("PlayerGui")

	local container = Instance.new("Frame")
	container.BackgroundTransparency = 1
	container.Size = UDim2.fromOffset(16, 16)
	container.AnchorPoint = Vector2.new(0.5, 0.5)
	container.Parent = gui
	local lines = {}
	for i = 1, 4 do
		local f = Instance.new("Frame")
		f.BorderSizePixel = 0
		f.ZIndex = 5
		f.Parent = container
		addStroke(f, Enum.ApplyStrokeMode.Border)
		lines[i] = f
	end

	local label = Instance.new("TextLabel")
	label.Text = ":3"
	label.Font = Enum.Font.Cartoon 
    label.Rotation = 90
	label.TextScaled = true
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromOffset(150, 23)
	label.ZIndex = 6
	label.Parent = gui
	addStroke(label, Enum.ApplyStrokeMode.Contextual)

	local function rotationSpeed(p)
		if p < 0.6 then return ROT_SPEED end
		local s = (p - 0.6) / 0.35
		return ROT_SPEED * math.max(1 - s * s * 0.7, 0.3)
	end

	RunService.RenderStepped:Connect(function(dt)
        
		t += dt
		progress = (progress + rotationSpeed(progress) * dt) % 1

		container.Position = UDim2.fromOffset(Mouse.X, Mouse.Y)
		container.Rotation = progress * 360
		label.Position = UDim2.fromOffset(Mouse.X - 70, Mouse.Y + 50)

		local pulse = (math.sin(t * PULSE_SPEED) * 0.5 + 0.5) ^ 2
		local len = MIN_LEN + (MAX_LEN - MIN_LEN) * pulse
		local half = -THICKNESS / 2

		lines[1].Size, lines[1].Position = UDim2.fromOffset(THICKNESS, len), UDim2.new(0.5, half, 0, 0)
		lines[2].Size, lines[2].Position = UDim2.fromOffset(THICKNESS, len), UDim2.new(0.5, half, 1, -len)
		lines[3].Size, lines[3].Position = UDim2.fromOffset(len, THICKNESS), UDim2.new(0, 0, 0.5, half)
		lines[4].Size, lines[4].Position = UDim2.fromOffset(len, THICKNESS), UDim2.new(1, -len, 0.5, half)

		local color = Color3.new(
			math.sin(t * 0.6) * 0.5 + 0.5,
			math.sin(t * 0.6 + 2) * 0.5 + 0.5,
			math.sin(t * 0.6 + 4) * 0.5 + 0.5
		)
		for _, l in lines do l.BackgroundColor3 = color end
		label.TextColor3 = color
	end)
end 
